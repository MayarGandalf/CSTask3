<Window x:Class="WpfApp3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DataManager" 
        Height="500" Width="800"
        WindowState="Maximized">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="71*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Кнопки -->
            <RowDefinition Height="Auto"/>
            <!-- Фильтры -->
            <RowDefinition Height="Auto"/>
            <!-- Пагинация + статус -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
        </Grid.RowDefinitions>

        <!-- Строка 0: кнопки управления -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10" Grid.ColumnSpan="2">
            <Button x:Name="BtnLoad" Click="BtnLoad_Click" Width="150" Margin="0,0,10,0">📂 Загрузить CSV</Button>
            <Button x:Name="BtnApplyFilter" Click="BtnApplyFilter_Click" Width="130" Margin="0,0,10,0">🔍 Применить фильтр</Button>
            <Button x:Name="BtnClearFilter" Click="BtnClearFilter_Click" Width="120" Margin="0,0,10,0">🧹 Сбросить фильтр</Button>
            <Button x:Name="BtnExportExcel" Click="BtnExportExcel_Click" Width="140" Margin="0,0,10,0">📊 Экспорт в Excel</Button>
            <Button x:Name="BtnExportXml" Click="BtnExportXml_Click" Width="140">📄 Экспорт в XML</Button>
        </StackPanel>

        <!-- Строка 1: поля фильтрации -->
        <WrapPanel Grid.Row="1" VerticalAlignment="Top" Grid.ColumnSpan="2">
            <TextBlock Text="Id:" VerticalAlignment="Center" Margin="5,0,0,0"/>
            <TextBox x:Name="TbId" Width="60" VerticalAlignment="Center" Margin="2,0,5,0"/>

            <TextBlock Text="Имя:" VerticalAlignment="Center" Margin="5,0,0,0"/>
            <TextBox x:Name="TbFirstName" Width="80" VerticalAlignment="Center" Margin="2,0,5,0"/>

            <TextBlock Text="Фамилия:" VerticalAlignment="Center" Margin="5,0,0,0"/>
            <TextBox x:Name="TbLastName" Width="80" VerticalAlignment="Center" Margin="2,0,5,0"/>

            <TextBlock Text="Отчество:" VerticalAlignment="Center" Margin="5,0,0,0"/>
            <TextBox x:Name="TbMiddleName" Width="80" VerticalAlignment="Center" Margin="2,0,5,0"/>

            <TextBlock Text="Город:" VerticalAlignment="Center" Margin="5,0,0,0"/>
            <TextBox x:Name="TbCity" Width="80" VerticalAlignment="Center" Margin="2,0,5,0"/>

            <TextBlock Text="Страна:" VerticalAlignment="Center" Margin="5,0,0,0"/>
            <TextBox x:Name="TbCountry" Width="80" VerticalAlignment="Center" Margin="2,0,5,0"/>

            <TextBlock Text="Дата с:" VerticalAlignment="Center" Margin="5,0,0,0"/>
            <DatePicker x:Name="DpDateFrom" VerticalAlignment="Center" Margin="2,0,5,0" Width="100"/>

            <TextBlock Text="по:" VerticalAlignment="Center" Margin="5,0,0,0"/>
            <DatePicker x:Name="DpDateTo" VerticalAlignment="Center" Margin="2,0,5,0" Width="100"/>
        </WrapPanel>

        <!-- Строка 2: пагинация + статус -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="117,52,0,221" HorizontalAlignment="Left" Grid.Column="1">
            <Button x:Name="BtnPrevPage" Click="BtnPrevPage_Click" Width="60" Margin="0,0,5,0">◀</Button>
            <TextBlock Text="Страница" VerticalAlignment="Center" Margin="5,0,5,0"/>
            <TextBox x:Name="TbPageNumber" Text="1" Width="40" TextAlignment="Center" VerticalAlignment="Center" Margin="2,0,5,0" KeyDown="TbPageNumber_KeyDown"/>
            <TextBlock Text="из" VerticalAlignment="Center" Margin="5,0,5,0"/>
            <TextBlock x:Name="TbTotalPages" Text="0" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <Button x:Name="BtnNextPage" Click="BtnNextPage_Click" Width="60" Margin="5,0,0,0">▶</Button>
            <TextBlock Text=" | Записей:" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBlock x:Name="TbTotalRecords" Text="0" VerticalAlignment="Center" Margin="2,0,0,0"/>
            <TextBlock Text=" | " VerticalAlignment="Center" Margin="5,0,5,0"/>
            <TextBlock x:Name="TbStatus" Text="Готово" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Строка 3: DataGrid -->
        <DataGrid x:Name="DgRecords" Grid.Row="1" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  HorizontalScrollBarVisibility="Disabled"
                  Margin="0,82,0,10" Grid.ColumnSpan="2" Grid.RowSpan="3">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="*" />
                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" Width="*" />
                <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="*" />
                <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="*" />
                <DataGridTextColumn Header="Middle Name" Binding="{Binding MiddleName}" Width="*" />
                <DataGridTextColumn Header="City" Binding="{Binding City}" Width="*" />
                <DataGridTextColumn Header="Country" Binding="{Binding Country}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>